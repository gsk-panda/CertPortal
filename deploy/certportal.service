# CertPortal systemd unit for RHEL 9 (alternative to docker compose)
#
# Setup:
#   sudo dnf module install nodejs:20
#   sudo useradd -r -m -d /opt/certportal certportal
#   sudo -u certportal git clone <repo> /opt/certportal/app && cd /opt/certportal/app && sudo -u certportal npm ci --omit=dev
#   sudo install -m 600 -o certportal .env /opt/certportal/app/.env   # from .env.example
#   sudo cp deploy/certportal.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now certportal
#
# PostgreSQL 15+ must be reachable at DATABASE_URL (e.g. dnf module install postgres:16).

[Unit]
Description=CertPortal - certificate lifecycle automation for PAN-OS
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=certportal
Group=certportal
WorkingDirectory=/opt/certportal/app
EnvironmentFile=/opt/certportal/app/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/certportal/app
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
# If the built-in DNS responder must bind udp/53, instead set:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
