<%- include('../partials/head', { title }) %>
<div class="page-head">
  <div><h1>Billing</h1><p class="sub">Plan, usage, and payment for <%= currentOrg.name %>.</p></div>
  <% if (subscription && subscription.stripe_customer_id) { %>
    <form method="post" action="/billing/portal">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit">Manage billing</button>
    </form>
  <% } %>
</div>

<% if (plan.key === 'free') { %>
  <div class="panel">You're on the free plan. Upgrade below for more domains, certificates, firewalls and agents.</div>
<% } %>

<% if (!standing) { %>
  <div class="banner-warn"><%= plan.key === 'trial' ? 'Your free trial has ended.' : 'Your subscription is inactive.' %>
  Choose a plan below to restore full access.</div>
<% } %>

<div class="panel">
  <div class="kv">
    <dt>Current plan</dt><dd><strong><%= plan.label %></strong></dd>
    <dt>Status</dt><dd><span class="badge <%= standing ? 'green' : 'red' %>"><%= plan.key === 'free' ? 'active' : (subscription ? subscription.status : (plan.key === 'trial' ? 'trialing' : 'active')) %></span></dd>
    <% if (plan.key === 'trial' && trialEndsAt) { %>
      <dt>Trial ends</dt><dd><%= new Date(trialEndsAt).toISOString().slice(0,10) %></dd>
    <% } %>
    <% if (subscription && subscription.current_period_end) { %>
      <dt>Renews</dt><dd><%= new Date(subscription.current_period_end).toISOString().slice(0,10) %></dd>
    <% } %>
  </div>
</div>

<h2>Usage</h2>
<table>
  <thead><tr><th>Resource</th><th>Used</th><th>Included</th></tr></thead>
  <tbody>
    <% const fmt = (v) => v === null || v === undefined ? 'Unlimited' : v; %>
    <tr><td>Firewalls</td><td><%= usage.firewalls %></td><td><%= fmt(plan.limits.firewalls) %></td></tr>
    <tr><td>Domains</td><td><%= usage.domains %></td><td><%= fmt(plan.limits.domains) %></td></tr>
    <tr><td>Certificates</td><td><%= usage.certificates %></td><td><%= fmt(plan.limits.certificates) %></td></tr>
    <tr><td>Agents</td><td><%= usage.agents %></td><td><%= fmt(plan.limits.agents) %></td></tr>
  </tbody>
</table>

<h2>Plans</h2>
<% if (!stripeConfigured) { %>
  <div class="banner-warn">Payment isn't wired up yet on this deployment (no Stripe key configured). Plans below are for preview.</div>
<% } %>
<div class="statgrid">
  <% plans.forEach(p => { %>
    <div class="panel" style="margin:0">
      <h3 style="margin-top:0"><%= p.label %> <% if (p.key === plan.key) { %><span class="badge green">current</span><% } %></h3>
      <ul style="font-size:.88rem;padding-left:1.1rem;color:var(--text-dim)">
        <li><%= p.limits.firewalls === null ? 'Unlimited' : p.limits.firewalls %> firewalls</li>
        <li><%= p.limits.domains === null ? 'Unlimited' : p.limits.domains %> domains</li>
        <li><%= p.limits.certificates === null ? 'Unlimited' : p.limits.certificates %> certificates</li>
        <li><%= p.limits.agents === null ? 'Unlimited' : p.limits.agents %> agents</li>
        <li><%= p.features.monitoring ? '✓' : '—' %> monitoring</li>
        <li><%= p.features.panovision ? '✓' : '—' %> Panovision (log search)</li>
        <li><%= p.features.change_mgmt ? '✓' : '—' %> change management</li>
      </ul>
      <% if (p.key !== plan.key) { %>
        <form method="post" action="/billing/checkout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="plan" value="<%= p.key %>">
          <button class="btn primary" type="submit" <%= stripeConfigured ? '' : 'disabled' %>>Choose <%= p.label %></button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>
<%- include('../partials/tail') %>
