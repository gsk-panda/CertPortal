<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset password · CertPortal</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Reset password</h1>
    <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
    <form method="post" action="/password-reset" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Email
        <input type="email" name="email" required autofocus>
      </label>
      <button class="btn primary" type="submit">Send reset link</button>
    </form>
    <p style="margin-top:1rem;font-size:.85rem"><a href="/login">← Back to sign in</a></p>
  </div>
</div>
</body>
</html>
